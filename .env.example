# UV Configuration
# Set UV_NO_SYNC=1 to prevent uv from automatically modifying or re-syncing dependencies on uv run / make commands.
# This preserves whichever PyTorch flavor was explicitly installed via `make install` (CPU) or `make install-gpu` (CUDA).
UV_NO_SYNC=1

# Docker volume overrides (optional, defaults shown)
# HF_CACHE_DIR=~/.cache/huggingface
# DATA_DIR=./data
